# Copy this to .env.production before building for PWA/APK/real deployment.
# Without this, the app calls localhost:8766 — that only works when frontend
# and backend run on the same machine (local dev). A phone installing the PWA
# or APK has no backend of its own, so this MUST point at your real deployed
# backend (Railway/Render/your own VPS, etc.) with HTTPS.

VITE_API_URL=https://your-backend-domain.com
